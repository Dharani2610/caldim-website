# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
*.traineddata
.cache/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# ── Secrets and local data ───────────────────────────────────────────────────
# .env holds real secrets; only .env.example belongs in version control.
.env
.env.*
!.env.example

# Local scratch. The database is Supabase and media is Cloudinary, so nothing
# durable is written here any more — but keep this in case of local dumps.
/data
/backup
*.dump
