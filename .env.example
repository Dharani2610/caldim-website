# ─────────────────────────────────────────────────────────────────────────────
#  Caldim Engineering — environment
#
#  Copy to .env and fill in.  cp .env.example .env
#  Check your setup at any time with:  npm run doctor
# ─────────────────────────────────────────────────────────────────────────────

# ── Site ─────────────────────────────────────────────────────────────────────
# Canonical public origin. Cookies are scoped to it and absolute URLs built
# from it, so it must match how the site is actually reached.
SITE_URL="http://localhost:3000"


# ── Supabase / Postgres ──────────────────────────────────────────────────────
# Supabase → Project Settings → Database → Connection string → URI
#
# TWO strings, and the difference matters:
#
#   DATABASE_URL         the POOLED connection, port 6543 (Supavisor).
#                        This is what the app uses. Next opens many short-lived
#                        server contexts, and a direct connection per context
#                        exhausts Postgres' connection slots quickly.
#
#   DIRECT_DATABASE_URL  the DIRECT connection, port 5432.
#                        Used only by `npm run db:migrate`. DDL and the
#                        migrator's advisory lock are per-connection state, and
#                        the pooler hands connections between clients — a
#                        migration run over the pooler can deadlock or apply
#                        half a change set.
DATABASE_URL="postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres"
DIRECT_DATABASE_URL="postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# Supabase always requires TLS. Set false only for a local Postgres.
DATABASE_SSL="true"
# Connections per instance. Raise only if you have the pooler headroom.
DATABASE_POOL_MAX="10"


# ── MongoDB ──────────────────────────────────────────────────────────────────
# Local MongoDB connection URI (or MongoDB Atlas connection string)
# MONGODB_URI="mongodb://localhost:27017"


# ── Cloudinary ───────────────────────────────────────────────────────────────
# Cloudinary console → Settings → API Keys
#
# The API secret signs uploads and deletes. It is read on the server only and
# never reaches a client bundle — do not prefix it with NEXT_PUBLIC_.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
# Everything the site uploads is namespaced under this folder.
CLOUDINARY_FOLDER="caldim"


# ── Secrets ──────────────────────────────────────────────────────────────────
# Generate each one separately — never reuse a value between them:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# In development these may be left blank and ephemeral ones are generated at
# startup. In production the process refuses to boot without them.
SESSION_SECRET=""
APP_ENCRYPTION_KEY=""
IP_HASH_SALT=""


# ── Sessions ─────────────────────────────────────────────────────────────────
SESSION_IDLE_MINUTES="60"
SESSION_ABSOLUTE_HOURS="12"
MAX_LOGIN_ATTEMPTS="5"
LOCKOUT_MINUTES="15"

# Require 2FA enrolment before the admin area unlocks.
REQUIRE_TOTP="false"
# Set false only when terminating TLS somewhere that isn't HTTPS.
SECURE_COOKIES="true"


# ── Uploads ──────────────────────────────────────────────────────────────────
# Photos are re-encoded on our server before going to Cloudinary, so this
# ceiling bounds what a request handler has to hold in memory.
MAX_UPLOAD_BYTES="5242880"
# RFQ attachments from the public contact form.
MAX_PUBLIC_UPLOAD_BYTES="26214400"
# Video goes browser → Cloudinary directly and never through our server, so it
# can be far larger than the two above.
MAX_VIDEO_UPLOAD_BYTES="209715200"


# ── First admin account (used once, by npm run db:seed) ──────────────────────
ADMIN_EMAIL="admin@caldimengg.com"
ADMIN_NAME="Caldim Administrator"


# ── Optional: Outbound SMTP Email (RFQ Notifications + Auto-Confirmations) ───
# Standard SMTP credentials (e.g. Amazon SES, Brevo, SendGrid, Postmark, Google Workspace,
# or your hosting provider).
#
# If unset, email sending is skipped gracefully without failing form submissions.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
# Set true for TLS on port 465, or false for STARTTLS on port 587 / 25
SMTP_SECURE="false"
# The authorized sender address configured in your SMTP provider
SMTP_FROM_EMAIL=""
# Display name for outbound messages (e.g., "Caldim Engineering")
SMTP_FROM_NAME="Caldim Engineering"
# Internal email address that receives new RFQ notifications
CONTACT_NOTIFY_EMAIL="quotes@caldimengg.com"

